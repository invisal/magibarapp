{
  "name": "Magibar",
  "version": "0.0.2",
  "description": "Simple launcher",
  "main": "./out/main/index.js",
  "private": true,
  "type": "module",
  "author": "Visal In",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "dist": "electron-vite build && electron-builder --win",
    "dist:dir": "electron-vite build && electron-builder --win --dir",
    "dist:mac": "electron-vite build && electron-builder --mac",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "release:win": "electron-vite build && electron-builder --win --publish always",
    "release:mac": "electron-vite build && electron-builder --mac --publish always",
    "release:linux": "electron-vite build && electron-builder --linux --publish always",
    "build:native:mac": "cd native/mac && npm run build",
    "build:native:win": "cd native/win && npm run build",
    "build:native:linux": "cd native/linux && npm run build",
    "test": "node --disable-warning=ExperimentalWarning --test \"src/**/*.test.ts\"",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx}\"",
    "typecheck:node": "tsc --noEmit -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "chrono-node": "^2.10.1",
    "countries-and-timezones": "^3.10.0",
    "date-fns": "^4.4.0",
    "date-fns-tz": "^3.2.0",
    "electron-updater": "^6.8.9",
    "mathjs": "^15.2.0"
  },
  "optionalDependencies": {
    "@magibar/win": "file:native/win",
    "@magibar/mac": "file:native/mac",
    "@magibar/linux": "file:native/linux",
    "electron-liquid-glass": "^1.1.1"
  },
  "devDependencies": {
    "@base-ui/react": "^1.7.0",
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/state": "^6.7.2",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.10",
    "@napi-rs/cli": "^3.8.6",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript/vfs": "^1.6.1",
    "@valtown/codemirror-ts": "^2.3.1",
    "@vitejs/plugin-react": "^5.0.0",
    "cnfast": "^0.1.0",
    "codemirror": "^6.0.2",
    "electron": "^44.0.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "immer": "^11.1.18",
    "playwright": "^1.63.0",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.3",
    "use-immer": "^0.11.0",
    "vite": "^7.3.6"
  },
  "allowScripts": {
    "file:../../native/win": true,
    "file:../../native/mac": true,
    "file:../../native/linux": true,
    "esbuild": true,
    "electron-winstaller": true
  }
}
